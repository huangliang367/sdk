{
  // 让 clangd 用交叉 gcc 解析系统头文件（compile_commands.json 里的编译器是
  // aarch64-none-linux-gnu-gcc；clangd 默认不信任非系统编译器，不加会导致索引时
  // 找不到交叉工具链头文件）。optee 若曾用系统默认 aarch64-linux-gnu-gcc 构建，
  // 其编译数据库引用该编译器，故一并加白
  "clangd.arguments": [
    "--query-driver=${workspaceFolder}/toolchains/aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-*,/bin/aarch64-linux-gnu-*"
  ],
  // 同时装了微软 C/C++ 插件时，禁止它的 IntelliSense，避免与 clangd 抢 C/C++
  // 语言服务导致跳转失效（二者并存时以 cpptools 为默认，而它未配置 compileCommands）
  "C_Cpp.intelliSenseEngine": "disabled"
}
